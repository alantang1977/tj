# ==============================================================================
# TANG TV / WebHTV 单一入口脚本 —— 配置示例
# ------------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为  custom/config.env  （脚本只读取 config.env，不会读取本示例）
#   2. 按需要修改下面的值；留空的项保持脚本内默认即可
#   3. 不要把 .jks / local.properties / 密码 / Base64 keystore 内容提交进 Git
#
# 说明：custom/config.env 中的值会覆盖 scripts/gen_app_icon.py 内 CONFIG 的默认值。
#       本文件仅为示例，仓库里已有的 custom/config.env 请保留，不要用本文件覆盖。
# ==============================================================================

# ---- 应用身份（覆盖安装的主键，切勿改成其它包名）-----------------------------
# 必须保持旧 TANG TV 的 applicationId；脚本会拒绝改成其它包名。
PACKAGE_NAME="com.silent.android.tangtv"

# ---- 应用显示名称（英文 / 简体 / 繁体）---------------------------------------
APP_NAME="TANG TV"
APP_NAME_ZH_CN="湯影視"
APP_NAME_ZH_TW="湯影視"

# ---- 版本号 ------------------------------------------------------------------
# versionName 后缀，例如 "-beta1"；不需要就留空。
VERSION_NAME_SUFFIX=""
# versionCode：必须高于设备上已安装版本。旧仓库基线 560，首次升级用 561；
# 以后每次发布递增（562、563…）。脚本会拒绝把 versionCode 降到当前值以下。
VERSION_CODE="561"

# ---- 旧版覆盖安装签名锁定（公开证书指纹，不是私钥/密码）---------------------
# 必须从旧 TANG TV 已安装 APK（或与设备同版本/同 flavor/同 ABI 的旧 Release APK）
# 提取 Signer #1 certificate SHA-256 digest（64 位十六进制，可带或不带冒号）。
# 提取方式：把旧 APK 拖到 tools/get_old_apk_signer.bat 上。
# 未填或与 Release keystore 不一致时，CI 的 --verify-signing / --verify-apk-signature
# 会阻断发布。在拿到正确指纹前不要触发正式 Release。
EXPECTED_RELEASE_CERT_SHA256="在这里粘贴旧APK的64位SHA-256证书指纹"

# ---- CNB 仓库（格式：用户名/仓库名）-----------------------------------------
CNB_REPO_SLUG="tangtang.com.cn.kul/juntv"

# ---- 设置页作者链接（留空则不修改对应链接）-----------------------------------
AUTHOR_GITHUB="https://github.com/alantang1977/tj"
AUTHOR_CNB="https://cnb.cool/tangtang.com.cn.kul/juntv"

# ---- 检查更新：GitHub 仓库（格式：用户名/仓库名）；CNB 部分自动用 CNB_REPO_SLUG
UPDATE_GITHUB_REPO="alantang1977/tj"

# ---- 可选自定义素材（放在 custom/ 目录，文件名与下面一致即可）---------------
# startup_logo.png    开机启动图（可选；未提供则保留项目现有启动图）
# mobile_startup.png  手机端启动图（可选；未提供则保留项目现有启动图）
STARTUP_LOGO="startup_logo.png"
MOBILE_STARTUP="mobile_startup.png"

# ---- 图标模式（固定，请勿修改）----------------------------------------------
# 图标使用 scripts/assets/icon-style-image 中的唯一母版与预制资源，
# 不再支持旧的 cat / 3d / iphone17 程序化绘图模式。
ICON_STYLE="image"
