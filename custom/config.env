# ============================================================
# custom/config.env —— local_customize.py 配置文件（可选）
# 说明：
#   1. 把本文件放到项目 custom/ 目录下（没有就新建 custom/ 文件夹）
#   2. 运行 local_customize.py 时，会【优先】使用本文件的值覆盖脚本顶部配置
#   3. 不想要 config.env，也可以直接把配置写在脚本顶部 CONFIG 里
# 注意：此文件同时也是 GitHub Actions 中 apply_custom.py 的配置来源，
#       两处保持一致的配置，本地与 CI 效果完全相同。
# ============================================================

# APK 安装包名（只改安装标识，不修改 namespace！）
PACKAGE_NAME="com.silent.android.tangtv"

# 默认 / 英文 app 名称
APP_NAME="TANG TV"

# 简体中文 app 名称（与繁体一致，使用「湯影視」）
APP_NAME_ZH_CN="湯影視"

# 繁体中文 app 名称
APP_NAME_ZH_TW="湯影視"

# versionName 后缀（不需要就留空）
VERSION_NAME_SUFFIX=""

# CNB 仓库地址（真实存在的仓库，格式：用户名/仓库名）
CNB_REPO_SLUG="tangtang.com.cn.kul/juntv"

# 设置页作者链接（URL_GITHUB / URL_CNB，留空则不修改对应链接）
AUTHOR_GITHUB="https://github.com/alantang1977/tj"
AUTHOR_CNB="https://cnb.cool/tangtang.com.cn.kul/juntv"
