<?xml version="1.0" encoding="utf-8"?>
<!--
    电视版「应用表面」热搜词胶囊的统一焦点环（SearchActivity 热搜词行）。
    取值与 shape_item_focused.xml 完全一致：@dimen/webhtv_focus_ring_width + ?attr/tvFocusRing。
    此前这里是 `1.5dp @color/white`，与同一搜索页的搜索范围按钮（shape_item_focused）蓝色
    1.5dp 并存，属于用户报告「蓝色边框 / 白色边框 / 粗细不一样」的同一族缺陷。
    统一规范见 docs/TV-FOCUS-RING-20261004-unified-theme-ring.md。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/black_40" />

    <corners android:radius="8dp" />

    <stroke
        android:width="@dimen/webhtv_focus_ring_width"
        android:color="?attr/tvFocusRing" />

</shape>
